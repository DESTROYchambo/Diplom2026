;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="DiplomGame"
run/main_scene="uid://b5psmvqbqc871"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

ToolManager="*res://scripts/globals/tool_manager.gd"
InventoryManager="*res://scripts/globals/inventory_manager.gd"
ChickenManager="*res://scripts/globals/chicken_manager.gd"

[display]

